# Copy to .env and export these values in your shell before starting the app.
# This file contains placeholders only; never commit a real .env file.
DB_URL=jdbc:postgresql://localhost:5432/resolve_db
DB_USERNAME=resolve_app
DB_PASSWORD=change_me_locally
SERVER_PORT=8080
# Generate a random Base64 value from at least 32 random bytes for local use.
# Example generation command is in docs/setup-guide.md; do not commit real secrets.
JWT_SECRET_BASE64=REPLACE_WITH_RANDOM_BASE64_SECRET
JWT_EXPIRATION_MS=900000

# Docker Compose PostgreSQL configuration. These are local placeholders only.
POSTGRES_DB=resolve_db
POSTGRES_USER=resolve_app
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_LOCAL_PORT=5432
